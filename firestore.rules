rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Correos que pueden activar jornadas (los mismos que ADMINS en js/quiniela.js)
    function esAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['fjimenezsantana1@gmail.com', 'santana282004@gmail.com'];
    }

    // Una ficha por jornada con su hora de cierre (24 h antes del partido).
    // La crea la web automáticamente cuando el administrador entra en la quiniela.
    match /quinielas/{jornada} {
      allow read: if true;
      allow create, update: if esAdmin()
        && request.resource.data.keys().hasOnly(['n', 'partido', 'inicio', 'cierre'])
        && request.resource.data.n is int
        && jornada == 'j' + string(request.resource.data.n)
        && request.resource.data.cierre is timestamp
        && request.resource.data.inicio is timestamp;
      allow delete: if esAdmin();

      // Apuestas: cualquiera las ve; cada persona solo crea o cambia la suya
      // y solo antes del cierre de esa jornada.
      match /apuestas/{uid} {
        function ficha() { return get(/databases/$(database)/documents/quinielas/$(jornada)).data; }
        allow read: if true;
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && exists(/databases/$(database)/documents/quinielas/$(jornada))
          && request.time < ficha().cierre
          && request.resource.data.keys().hasOnly(['nombre', 'avatar', 'jugador', 'categoria', 'prediccion', 'jornada', 'actualizada'])
          && request.resource.data.nombre is string && request.resource.data.nombre.size() <= 80
          && request.resource.data.avatar is string && request.resource.data.avatar.size() <= 500
          && request.resource.data.jugador is string && request.resource.data.jugador.size() <= 60
          && request.resource.data.categoria in ['goles', 'asistencias', 'tarjetas']
          && request.resource.data.prediccion in ['0', '1', '2', '3+', 'Ninguna', 'Amarilla', 'Doble amarilla', 'Roja']
          && request.resource.data.jornada == ficha().n;
        allow delete: if request.auth != null && request.auth.uid == uid
          && request.time < ficha().cierre;
      }
    }
    // Convocatoria: cada jugador responde con su ENLACE PERSONAL (?c=código).
    // codigos/{código} -> { jugador, nombre }. Se puede leer un código solo si ya lo conoces;
    // listar, crear o borrar códigos solo pueden los administradores.
    match /codigos/{codigo} {
      allow get: if true;
      allow list, delete: if esAdmin();
      allow create, update: if esAdmin()
        && request.resource.data.keys().hasOnly(['jugador', 'nombre'])
        && request.resource.data.jugador is string && request.resource.data.jugador.size() <= 60
        && request.resource.data.nombre is string && request.resource.data.nombre.size() <= 60;
    }

    // Respuestas: el documento se llama como el código, así que sin el enlace personal
    // nadie puede responder en nombre de otro. Solo los administradores las leen.
    match /asistencias/{jornada}/respuestas/{codigo} {
      function dueno() { return get(/databases/$(database)/documents/codigos/$(codigo)).data; }
      allow read, delete: if esAdmin();
      allow create, update: if exists(/databases/$(database)/documents/codigos/$(codigo))
        && request.resource.data.keys().hasOnly(['jugador', 'nombre', 'asiste', 'dorsal', 'motivo', 'jornada', 'actualizada'])
        && request.resource.data.jugador == dueno().jugador
        && request.resource.data.nombre is string && request.resource.data.nombre.size() <= 60
        && request.resource.data.jornada is int
        && jornada == 'j' + string(request.resource.data.jornada)
        && request.resource.data.actualizada == request.time
        && request.resource.data.motivo is string && request.resource.data.motivo.size() <= 300
        && request.resource.data.asiste is bool
        && (request.resource.data.asiste
              ? (request.resource.data.dorsal is int && request.resource.data.dorsal >= 0 && request.resource.data.dorsal <= 99)
              : (request.resource.data.dorsal == null && request.resource.data.motivo.size() >= 3));
    }
  }
}
