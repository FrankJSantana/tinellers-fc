rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Correos que pueden activar jornadas (los mismos que ADMINS en js/fantasy.js)
    function esAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['fjimenezsantana1@gmail.com', 'santana282004@gmail.com'];
    }

    // Una ficha por jornada con su hora de cierre (24 h antes del partido).
    // La crea la web automáticamente cuando el administrador entra en el fantasy.
    // (Se llama "quinielas" porque nació con la quiniela, que ya no existe.)
    match /quinielas/{jornada} {
      allow read: if true;
      allow create, update: if esAdmin()
        && request.resource.data.keys().hasOnly(['n', 'partido', 'inicio', 'cierre'])
        && request.resource.data.n is int
        && jornada == 'j' + string(request.resource.data.n)
        && request.resource.data.cierre is timestamp
        && request.resource.data.inicio is timestamp;
      allow delete: if esAdmin();
    }

    // Fantasy: un equipo por cuenta de Google y jornada (fantasy/j4/equipos/{uid}).
    // La hora de cierre es la de quinielas/{jornada}, la misma ficha que activa el administrador.
    // Cada uno ve su equipo; los de los demás se ven cuando cierra la jornada.
    // Jandro y Alfa no pueden ir juntos (tampoco saltándose la web).
    match /fantasy/{jornada}/equipos/{uid} {
      function ficha() { return get(/databases/$(database)/documents/quinielas/$(jornada)).data; }
      function nuevo() { return request.resource.data; }
      function valido(i) { return nuevo().jugadores[i] is string && nuevo().jugadores[i].size() <= 60; }
      allow get: if (request.auth != null && request.auth.uid == uid) || request.time >= ficha().cierre;
      allow list: if request.time >= ficha().cierre;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && exists(/databases/$(database)/documents/quinielas/$(jornada))
        && request.time < ficha().cierre
        && nuevo().keys().hasOnly(['nombre', 'avatar', 'jugadores', 'capitan', 'formacion', 'jornada', 'actualizada'])
        && nuevo().nombre is string && nuevo().nombre.size() <= 80
        && nuevo().avatar is string && nuevo().avatar.size() <= 500
        && nuevo().jugadores is list && nuevo().jugadores.size() == 5
        && valido(0) && valido(1) && valido(2) && valido(3) && valido(4)
        && nuevo().jugadores.toSet().size() == 5
        && nuevo().capitan is string && nuevo().capitan in nuevo().jugadores
        && !nuevo().jugadores.hasAll(['alejandro-cuevas', 'alfa-junior-umaro'])
        && nuevo().formacion in ['2-2', '3-1', '1-2-1']
        && nuevo().jornada is int && nuevo().jornada >= 4
        && nuevo().jornada == ficha().n
        && nuevo().actualizada == request.time;
      allow delete: if request.auth != null && request.auth.uid == uid
        && request.time < ficha().cierre;
    }

    // Convocatoria: solo se responde con el ENLACE DEL EQUIPO (?c=código) que el delegado
    // manda al grupo. codigos/{código} -> { jugador: 'equipo' }. Un código solo se puede leer
    // si ya lo conoces; listarlos o crearlos solo pueden los administradores.
    match /codigos/{codigo} {
      allow get: if true;
      allow list, delete: if esAdmin();
      allow create, update: if esAdmin()
        && request.resource.data.keys().hasOnly(['jugador', 'nombre'])
        && request.resource.data.jugador is string && request.resource.data.jugador.size() <= 60
        && request.resource.data.nombre is string && request.resource.data.nombre.size() <= 60;
    }

    // Respuestas: una por jugador y jornada; hace falta la clave del enlace del equipo.
    // Solo los administradores las leen.
    match /asistencias/{jornada}/respuestas/{jugador} {
      allow read, delete: if esAdmin();
      allow create, update: if jugador in ['arian-burguillo', 'alfa-junior-umaro', 'luis-nunez', 'esteban-morales', 'jefferson-marte', 'sebas-rodriguez-yanez', 'eloy-marte', 'piero-malasquez', 'junior-de-jesus', 'nacho-escalante', 'fidel-escalante-mateo', 'alejandro-cuevas', 'gilbert-natanael-de-jesus']
        && request.resource.data.keys().hasOnly(['clave', 'jugador', 'nombre', 'asiste', 'dorsal', 'motivo', 'jornada', 'actualizada'])
        && request.resource.data.clave is string && request.resource.data.clave.size() <= 40
        && exists(/databases/$(database)/documents/codigos/$(request.resource.data.clave))
        && get(/databases/$(database)/documents/codigos/$(request.resource.data.clave)).data.jugador == 'equipo'
        && request.resource.data.jugador == jugador
        && request.resource.data.nombre is string && request.resource.data.nombre.size() <= 60
        && request.resource.data.jornada is int
        && jornada == 'j' + string(request.resource.data.jornada)
        && request.resource.data.actualizada == request.time
        && request.resource.data.motivo is string && request.resource.data.motivo.size() <= 300
        && request.resource.data.asiste is bool
        && (request.resource.data.asiste
              ? (request.resource.data.dorsal is int && request.resource.data.dorsal >= 0 && request.resource.data.dorsal <= 99)
              : (request.resource.data.dorsal == null && request.resource.data.motivo.size() >= 3));
    }
  }
}
