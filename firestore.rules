rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Quiniela: cualquiera puede ver las apuestas; cada persona solo crea o cambia la suya
    // (el documento lleva su id de usuario) y solo antes del inicio del partido.
    match /quinielas/{jornada}/apuestas/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && jornada == 'j3'
        && request.time < timestamp.date(2026, 11, 8) + duration.value(18, 'h')
        && request.resource.data.keys().hasOnly(['nombre', 'avatar', 'jugador', 'categoria', 'prediccion', 'jornada', 'actualizada'])
        && request.resource.data.nombre is string && request.resource.data.nombre.size() <= 80
        && request.resource.data.avatar is string && request.resource.data.avatar.size() <= 500
        && request.resource.data.jugador is string && request.resource.data.jugador.size() <= 60
        && request.resource.data.categoria in ['goles', 'asistencias', 'tarjetas']
        && request.resource.data.prediccion in ['0', '1', '2', '3+', 'Ninguna', 'Amarilla', 'Doble amarilla', 'Roja']
        && request.resource.data.jornada == 3;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
